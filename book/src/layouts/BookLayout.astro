        text-align: center;
        backdrop-filter: blur(2px);
        padding: 16px;
      }
    </style>
  </head>
  <body data-base={base}>
    <main class="layout">
      <div>
        <slot />
        <div class="nav-links">
        {prevHref ? <a href={normalizeHref(prevHref)}>{`← ${prevLabel}`}</a> : <span class="spacer"></span>}
        {nextHref ? <a href={normalizeHref(nextHref)}>{`${nextLabel} →`}</a> : <span class="spacer"></span>}
      </div>
      </div>
      <aside class="toc-wrap">
        <details class="toc" open>
          <summary>Book Contents</summary>
          <input id="tocSearch" type="search" placeholder="Search chapters..." />
          <ul id="tocList">
            {chapters.map((item) => (
              <li>
                <a href={item.href} data-title={item.label.toLowerCase()}>{item.label}</a>
              </li>
            ))}
          </ul>
        </details>
      </aside>
    </main>
    <script is:inline>
      const rawBase = document.body.dataset.base || '/';
      const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
      window.SWITCH_SCANNER_ASSET_BASE = base;
    </script>
    <script type="module" src={`${base}components/switch-scanner.js`}></script>
    <script type="module">
      const rawBase = document.body.dataset.base || '/';
      const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
      const init = async () => {
        try {
          const [{ initReactionTest }, { initScanEstimator }, { initSettingsAdvisor }, sushi] = await Promise.all([
            import(`${base}scripts/reaction.js`),
            import(`${base}scripts/estimator.js`),
            import(`${base}scripts/advisor.js`),
            import(`${base}scripts/sushi.js`),
            import(`${base}scripts/glossary.js`)
          ]);
          initReactionTest();
          initScanEstimator();
          initSettingsAdvisor();
          sushi.initSushiDemo?.();
        } catch (err) {
          console.error('Failed to initialize interactive scripts:', err);
        }
      };

      if (document.readyState === 'loading') {
        window.addEventListener('DOMContentLoaded', init);
      } else {
        init();
      }
    </script>
    <script type="module">
      const list = document.getElementById('tocList');
      const search = document.getElementById('tocSearch');
      if (list && search) {
        const links = Array.from(list.querySelectorAll('a'));
        const current = window.location.pathname;
        links.forEach((link) => {
          if (current === link.getAttribute('href')) {
            link.classList.add('active');
          }
        });
        search.addEventListener('input', () => {
          const q = search.value.trim().toLowerCase();
          links.forEach((link) => {
            const label = link.dataset.title || '';
            const match = label.includes(q);
            link.parentElement?.toggleAttribute('hidden', !match);
          });
        // Auto-add linkable anchor icons to headings
        document.querySelectorAll('main h2, main h3').forEach((heading) => {
          if (!heading.id) {
            heading.id = heading.textContent.trim().toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
          }
          if (!heading.querySelector('.heading-anchor')) {
            const anchor = document.createElement('a');
            anchor.className = 'heading-anchor';
            anchor.href = '#' + heading.id;
            anchor.innerHTML = '🔗';
            anchor.title = 'Direct link to this section';
            heading.appendChild(anchor);
          }
        });
      }
    </script>
    <script is:inline>
      const renderMermaid = async () => {
        if (!window.mermaid) return;
        window.mermaid.initialize({
          startOnLoad: false,
          theme: 'neutral',
          fontFamily: 'Atkinson Hyperlegible, sans-serif'
        });

        const selectors = [
          'pre[data-language="mermaid"]',
          'code[data-language="mermaid"]',
          'pre.language-mermaid',
          'code.language-mermaid',
          'pre.mermaid',
          'div.mermaid'
        ];
        
        const candidateElements = Array.from(document.querySelectorAll(selectors.join(', ')));
        
        // Fallback: check all pre elements for mermaid keywords if not already matched
        document.querySelectorAll('main pre').forEach((pre) => {
          if (!candidateElements.includes(pre)) {
            const text = (pre.innerText || pre.textContent || '').trim();
            if (text.startsWith('flowchart') || text.startsWith('graph') || text.startsWith('sequenceDiagram') || text.startsWith('stateDiagram')) {
              candidateElements.push(pre);
            }
          }
        });

        for (let i = 0; i < candidateElements.length; i++) {
          const el = candidateElements[i];
          const pre = el.tagName.toLowerCase() === 'pre' ? el : el.closest('pre') || el;
          const graphDefinition = (pre.innerText || pre.textContent || '').trim();
          if (!graphDefinition) continue;

          const container = document.createElement('div');
          container.className = 'mermaid-diagram-wrap';
          container.style.display = 'flex';
          container.style.justifyContent = 'center';
          container.style.margin = '20px 0';
          container.style.padding = '16px';
          container.style.background = '#fffdf6';
          container.style.border = '2px dashed #d6d6d6';
          container.style.borderRadius = '14px';
          container.style.overflowX = 'auto';

          try {
            const id = `mermaid-svg-${Date.now()}-${i}`;
            const { svg } = await window.mermaid.render(id, graphDefinition);
            container.innerHTML = svg;
            if (pre && pre.parentNode) {
              pre.parentNode.replaceChild(container, pre);
            }
          } catch (err) {
            console.error('Mermaid render error:', err);
          }
        }
      };

      if (document.readyState === 'loading') {
        window.addEventListener('DOMContentLoaded', renderMermaid);
      } else {
        renderMermaid();
      }
    </script>
    <div id="diagramZoomModal" class="zoom-modal-backdrop" role="dialog" aria-modal="true" aria-label="Diagram Zoom View">
      <div class="zoom-modal-content" id="zoomModalContent">
        <button class="zoom-modal-close" id="zoomModalClose" aria-label="Close modal">✕</button>
        <div id="zoomModalTarget"></div>
      </div>
    </div>
    <script is:inline>
      const initZoomModal = () => {
        const modal = document.getElementById('diagramZoomModal');
        const targetContainer = document.getElementById('zoomModalTarget');
        const closeBtn = document.getElementById('zoomModalClose');
        if (!modal || !targetContainer) return;

        let activeReparent = null;

        const openModal = (element, isInteractive = false) => {
          if (activeReparent) closeModal();
          targetContainer.innerHTML = '';

          if (isInteractive) {
            const placeholder = document.createElement('div');
            placeholder.style.display = 'none';
            element.parentNode.insertBefore(placeholder, element);

            activeReparent = {
              element: element,
              placeholder: placeholder
            };

            element.classList.add('in-modal-fullscreen');
            targetContainer.appendChild(element);
          } else {
            let toClone = element;
            if (element.classList.contains('figure-card')) {
              const innerImgOrSvg = element.querySelector('img, svg');
              if (innerImgOrSvg) toClone = innerImgOrSvg;
            }
            const clone = toClone.cloneNode(true);
            clone.style.cursor = 'default';
            clone.style.margin = '0';
            clone.style.padding = '0';
            clone.style.maxWidth = '100%';
            clone.style.maxHeight = '100%';
            clone.style.width = 'auto';
            clone.style.height = 'auto';
            targetContainer.appendChild(clone);
          }

          modal.classList.add('active');
          document.body.style.overflow = 'hidden';
        };

        const closeModal = () => {
          if (activeReparent) {
            const { element, placeholder } = activeReparent;
            element.classList.remove('in-modal-fullscreen');
            if (placeholder && placeholder.parentNode) {
              placeholder.parentNode.insertBefore(element, placeholder);
              placeholder.remove();
            }
            activeReparent = null;
          }
          targetContainer.innerHTML = '';
          modal.classList.remove('active');
          document.body.style.overflow = '';
        };

        closeBtn?.addEventListener('click', closeModal);
        modal.addEventListener('click', (e) => {
          if (e.target === modal) closeModal();
        });
        window.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') closeModal();
        });

        const attachListeners = () => {
          // Static diagram targets (Mermaid & Figures)
          const staticTargets = document.querySelectorAll('.mermaid-diagram-wrap, .figure-card img, .figure-card, figure img');
          staticTargets.forEach((target) => {
            if (target.dataset.zoomBound) return;
            target.dataset.zoomBound = 'true';
            target.classList.add('zoomable-target');
            target.setAttribute('title', 'Click to zoom view');
            target.addEventListener('click', (e) => {
              e.stopPropagation();
              openModal(target, false);
            });
          });

          // Interactive demo targets (Scanner, Reaction Test, Estimator, Sushi, Settings Advisor)
          const interactiveTargets = document.querySelectorAll('.scanner-container, .reaction-test, .sushi-demo');
          interactiveTargets.forEach((card) => {
            if (card.dataset.badgeBound) return;
            card.dataset.badgeBound = 'true';
            card.classList.add('demo-card-relative');

            const badge = document.createElement('button');
            badge.className = 'demo-expand-badge';
            badge.type = 'button';
            badge.innerHTML = '🔍 Fullscreen Demo';
            badge.setAttribute('title', 'Play demo in fullscreen modal');
            
            badge.addEventListener('click', (e) => {
              e.stopPropagation();
              openModal(card, true);
            });

            card.appendChild(badge);
          });
        };

        attachListeners();
        setTimeout(attachListeners, 500);
        setTimeout(attachListeners, 1500);
      };

      if (document.readyState === 'loading') {
        window.addEventListener('DOMContentLoaded', initZoomModal);
      } else {
        initZoomModal();
      }
    </script>
  </body>
</html>
