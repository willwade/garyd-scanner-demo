---
const { frontmatter = {} } = Astro.props;
const {
  title = 'Switch Scanning Book',
  prevHref,
  prevLabel,
  nextHref,
  nextLabel
} = frontmatter;
const base = import.meta.env.BASE_URL;
const normalizeHref = (href?: string) => {
  if (!href) return undefined;
  if (href.startsWith('http')) return href;
  if (href.startsWith(base)) return href;
  if (href.startsWith('/')) {
    const cleaned = href.replace(/^\/+/, '');
    const trimmed = cleaned.startsWith('book/') ? cleaned.slice(5) : cleaned;
    return `${base}${trimmed}`;
  }
  return `${base}${href}`;
};
const chapterModules = Object.values(
  import.meta.glob('../pages/chapter-*.mdx', { eager: true })
) as Array<{ url?: string; frontmatter?: { title?: string } }>;

const chapters = chapterModules
  .map((mod) => {
    const href = mod.url ?? '';
    const label = mod.frontmatter?.title ?? href;
    const match = href.match(/chapter-(\d+)/);
    const order = match ? Number(match[1]) : 999;
    return { href: normalizeHref(href) ?? href, label, order };
  })
  .sort((a, b) => a.order - b.order);

const glossaryModule = Object.values(
  import.meta.glob('../pages/glossary.mdx', { eager: true })
) as Array<{ url?: string; frontmatter?: { title?: string } }>;

if (glossaryModule[0]) {
  chapters.push({
    href: normalizeHref(glossaryModule[0].url) ?? `${base}glossary/`,
    label: glossaryModule[0].frontmatter?.title ?? 'Glossary',
    order: 9999
  });
}
